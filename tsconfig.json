{
    "compilerOptions": {
        "target": "ES2017",
        "module": "ESNext",
        "rootDir": "./src",
        "declaration": true,
        "outDir": "./dist",
        "removeComments": true,
        "declarationDir": "./dist/types",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "lib": ["ES2017", "DOM"],
        "moduleResolution": "node",
        "sourceMap": true,
        "noImplicitAny": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "**/*.spec.ts", "dist"],
    "paths": {
        "@/*": ["./*"]
    }
}
